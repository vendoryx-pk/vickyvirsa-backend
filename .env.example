# Copy to .env and fill real values (.env is gitignored)
# Prefer Render-style names; VENDORYX_* aliases still work.

DB_URL=jdbc:postgresql://HOST/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_db_password

# Aliases (optional if DB_* set):
# VENDORYX_DB_URL=
# VENDORYX_DB_USER=
# VENDORYX_DB_PASSWORD=

VENDORYX_JWT_SECRET=replace-with-at-least-32-character-secret

# Comma-separated; trailing slashes stripped. Never use *
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Alias: VENDORYX_CORS_ORIGIN=

PORT=8080
