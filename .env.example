# Copy to .env and fill real values (.env is gitignored)
# Prefer Render-style names; VENDORYX_* aliases still work.

DB_URL=jdbc:postgresql://HOST/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=your_db_password

# Aliases (optional if DB_* set):
# VENDORYX_DB_URL=
# VENDORYX_DB_USER=
# VENDORYX_DB_PASSWORD=

VENDORYX_JWT_SECRET=replace-with-at-least-32-character-secret

# Comma-separated; trailing slashes stripped. Never use *
# Always merged with built-in defaults (localhost:4200 + Cloudflare Pages).
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://vickyvirsa-frontend.pages.dev
# Alias: VENDORYX_CORS_ORIGIN=
# On Render: set the same value, then Manual Deploy / restart the service.

PORT=8080

# Cloudinary signed uploads (POST /api/admin/uploads/sign) — secret never returned to clients
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
